// Grafana Alloy: discover every container through the Docker API, tail its logs,
// parse the app's JSON logs, and push to Loki.

discovery.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  refresh_interval = "15s"
}

// Turn Docker metadata into a small, fixed set of labels.
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "project"
  }
}

loki.source.docker "containers" {
  host             = "unix:///var/run/docker.sock"
  targets          = discovery.docker.containers.targets
  relabel_rules    = discovery.relabel.containers.rules
  refresh_interval = "15s"
  forward_to       = [loki.process.app.receiver]
}

loki.process "app" {
  // Only the app emits JSON we control; other containers pass through untouched.
  stage.match {
    selector = "{service=\"app\"}"

    stage.json {
      expressions = {
        level    = "level",
        path     = "path",
        method   = "method",
        status   = "status",
        ts       = "timestamp",
      }
    }

    // Use the app's own timestamp instead of the time Alloy read the line.
    stage.timestamp {
      source = "ts"
      format = "RFC3339"
    }

    // LOW-cardinality fields become index labels (bounded value sets):
    //   level  -> debug|info|warning|error|critical
    //   method -> GET|POST|...
    stage.labels {
      values = { level = "", method = "" }
    }

    // `path` and `status` are kept as structured metadata: filterable in Grafana
    // (`| path="/health"`) without creating one stream per URL/status code.
    stage.structured_metadata {
      values = { path = "", status = "" }
    }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
